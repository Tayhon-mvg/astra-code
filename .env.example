# Скопируйте в .env (или задайте переменные окружения).
# Astra читает .env из папки проекта и из ~/.astra/.env.
# Ключи также можно сохранить через: astra auth set <provider>

# OpenRouter — без карты и телефона, модели с суффиксом :free
OPENROUTER_API_KEY=

# Google AI Studio — Gemini 2.5 Pro/Flash, frontier-класс бесплатно
GEMINI_API_KEY=

# DeepSeek — V4.1 Flash / V4 Pro, 5M trial-кредитов, затем платно
DEEPSEEK_API_KEY=

# Groq — самый быстрый free-tier (нужна верификация телефона)
GROQ_API_KEY=

# SambaNova — free tier без карты
SAMBANOVA_API_KEY=

# Z.ai — GLM-4.7-Flash и другие Flash-модели за $0
ZAI_API_KEY=

# Cloudflare Workers AI — 10k Neurons/день; нужны оба значения
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Mistral — free mode, лимиты в консоли
MISTRAL_API_KEY=

# Ollama Cloud — стартовые кредиты
OLLAMA_API_KEY=

# OmniRoute — локальный free-роутер; ключ можно импортировать:
# astra auth set omniroute --from-omniroute
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1

# Опционально: официальный Brave Search API (free tier) для web_search.
# Без ключа Astra использует Bing RSS + DuckDuckGo.
BRAVE_SEARCH_API_KEY=

# Свой OpenAI-совместимый endpoint (локальный или бесплатный)
CUSTOM_API_KEY=
